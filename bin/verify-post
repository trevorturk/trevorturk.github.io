#!/bin/bash
# Usage: bin/verify-post [--allow-code-changes] [--allow-link-changes] [--new] _posts/YYYY-MM-DD-slug.md
# --allow-code-changes: for a fact-check pass that corrected code against the source repo.
# --allow-link-changes: when a link was deliberately removed or retargeted.
# --new: a post not yet on main; skips the diff checks and prints only the register report.
# PASS_DATE=YYYY-MM-DD: the date the Rewrite/Editing pass paragraph must carry (default: today).
# Checks a revised post against main: fenced code blocks unchanged,
# same ## headings in the same order, front matter date unchanged, and the
# meta section still carries the original prompts. Then prints the prose word
# count, retired-word hits, and sentences over 25 words. Exit 1 on any failure.
set -uo pipefail
ALLOW_CODE=0; ALLOW_LINKS=0; NEW=0; f=""
for a in "$@"; do case "$a" in --allow-code-changes) ALLOW_CODE=1;; --allow-link-changes) ALLOW_LINKS=1;; --new) NEW=1;; *) f="$a";; esac; done
cd /Users/trevorturk/Code/trevorturk.github.io
f="${f#/Users/trevorturk/Code/trevorturk.github.io/}"; fail=0
PASS_DATE="${PASS_DATE:-$(date +%F)}"
extract() { awk '/^```/{f=!f; print; next} f'; }
h2s() { awk '/^```/{f=!f; next} !f && /^## /'; }
body() { awk 'NR==1 && /^---/{fm=1; next} fm && /^---/{fm=0; next} !fm' | awk '/^## How This Post Was Made/{exit} {print}' | awk '/^```/{f=!f; next} !f' | grep -v '^> '; }
# retired words and flourishes from the blog-post-generator skill (Plain register)
RETIRED='byte-identical|byte for byte|that is the whole |is the whole |\bthe contract\b|\bsurfaces?\b|\bsurfaced\b|for free|adversarial|is what [^.]{1,40} buys|the thing [^.]{1,40} buys|has to be paid|pays for|on sight|\bbespoke\b|lean on|load-bearing|the key insight|where the pattern shines|the beauty of|nightmare|worth stealing|the interesting part|is the whole point|draws blood|the honest part|read that twice'
register() { # stdin: post text
  local b; b="$(body)"
  local hits; hits="$(printf '%s\n' "$b" | grep -oiE "$RETIRED" | tr 'A-Z' 'a-z' | sort | uniq -c | sort -rn | awk '{c=$1; $1=""; printf "%s(%d) ", substr($0,2), c}')"
  local long; long="$(printf '%s\n' "$b" | tr '\n' ' ' | sed -E 's/([.!?]) +/\1\n/g' | awk 'NF>25{n++} END{print n+0}')"
  local total; total="$(printf '%s\n' "$b" | tr '\n' ' ' | sed -E 's/([.!?]) +/\1\n/g' | awk 'NF>0{n++} END{print n+0}')"
  echo "words $(printf '%s\n' "$b" | wc -w | tr -d ' '), sentences over 25 words $long/$total, retired: ${hits:-none}"
}
new="$(cat "$f")"
if [ $NEW = 1 ]; then echo "new post: $(printf '%s\n' "$new" | register)"; exit 0; fi
old="$(git show "main:$f")"
if [ $ALLOW_CODE = 0 ] && ! diff <(printf '%s\n' "$old" | extract) <(printf '%s\n' "$new" | extract) >/dev/null; then
  echo "FAIL: code blocks differ from main"; diff <(printf '%s\n' "$old" | extract) <(printf '%s\n' "$new" | extract) | head -20; fail=1
fi
if ! diff <(printf '%s\n' "$old" | h2s) <(printf '%s\n' "$new" | h2s) >/dev/null; then
  echo "FAIL: ## headings differ from main"; diff <(printf '%s\n' "$old" | h2s) <(printf '%s\n' "$new" | h2s); fail=1
fi
if [ "$(printf '%s\n' "$old" | grep -m1 '^date:')" != "$(printf '%s\n' "$new" | grep -m1 '^date:')" ]; then
  echo "FAIL: date changed"; fail=1
fi
# every **Prompt...:** line from main must still be present verbatim
while IFS= read -r line; do
  [ -z "$line" ] && continue
  if ! printf '%s\n' "$new" | grep -qF -- "$line"; then echo "FAIL: original prompt line missing: ${line:0:80}..."; fail=1; fi
done < <(printf '%s\n' "$old" | grep -E '^\*\*Prompt( [0-9]+)?:\*\*')
if ! printf '%s\n' "$new" | grep -qE "^\*\*(Rewrite|Editing pass) \($PASS_DATE\):\*\*"; then echo "FAIL: no **Rewrite ($PASS_DATE):** or **Editing pass ($PASS_DATE):** paragraph"; fail=1; fi
# links to other posts must survive
[ $ALLOW_LINKS = 1 ] || for link in $(printf '%s\n' "$old" | grep -o '](/[a-z0-9-]*/)' | sort -u); do
  printf '%s\n' "$new" | grep -qF -- "$link" || { echo "FAIL: internal link dropped: $link"; fail=1; }
done
# raw tags balanced
r1=$(printf '%s\n' "$new" | grep -c '{% raw %}'); r2=$(printf '%s\n' "$new" | grep -c '{% endraw %}')
[ "$r1" = "$r2" ] || { echo "FAIL: raw/endraw unbalanced ($r1/$r2)"; fail=1; }
echo "main: $(printf '%s\n' "$old" | register)"
echo "now:  $(printf '%s\n' "$new" | register)"
[ $fail = 0 ] && echo "OK: $f"
exit $fail
